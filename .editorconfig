# ===============================
# Unity Team .editorconfig
# Target: VSCode + Unity
# ===============================

root = true

###############################
# Global (All files)
###############################
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 4

###############################
# C# (Unity Scripts)
###############################
[*.cs]

# Brace style
csharp_new_line_before_open_brace = all

# Indentation
csharp_indent_block_contents = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Spacing
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_cast = false
csharp_space_between_method_call_parentheses = false

###############################
# Unity Assets
###############################
[*.asmdef]
indent_size = 2

[*.json]
indent_size = 2

###############################
# YAML (Unity meta / scene)
###############################
[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2
